        // ガントチャート描画
        function renderGantt() {
            const container = document.getElementById('ganttChartContainer');
            const courts = ["上グラ", "下グラ", "体育館", "ハード", "オムニ", "卓球場"];
            const startHour = 8;
            const endHour = 16;
            const totalMins = (endHour - startHour) * 60;

            let html = `
                <div class="relative border-b border-slate-300 pb-2 mb-4 flex text-xs font-bold text-slate-400 pl-24">
            `;
            for (let h = startHour; h <= endHour; h++) {
                const leftPercent = ((h - startHour) * 60 / totalMins) * 100;
                html += `<div class="absolute" style="left: ${leftPercent}%">${String(h).padStart(2, '0')}:00</div>`;
            }
            html += `</div>`;

            // 各コートのタイムライン行
            courts.forEach(court => {
                const courtMatches = appState.schedule.filter(m => m.court === court);
                html += `
                    <div class="relative h-12 flex items-center border-b border-slate-100 pl-24 my-1">
                        <div class="absolute left-0 w-20 font-bold text-xs text-slate-700">${court}</div>
                        <div class="relative w-full h-8 bg-slate-100 rounded-lg overflow-hidden border border-slate-200">
                `;

                courtMatches.forEach(m => {
                    const actualStart = addMinutesToTimeStr(m.start, m.delay);
                    const actualEnd = addMinutesToTimeStr(m.end, m.delay);

                    const [sH, sM] = actualStart.split(':').map(Number);
                    const [eH, eM] = actualEnd.split(':').map(Number);

                    const startMinsTotal = (sH - startHour) * 60 + sM;
                    const endMinsTotal = (eH - startHour) * 60 + eM;

                    const left = (startMinsTotal / totalMins) * 100;
                    const width = ((endMinsTotal - startMinsTotal) / totalMins) * 100;
                    const isDelayed = m.delay > 0;

                    html += `
                        <div class="absolute top-1 bottom-1 rounded px-1.5 text-[10px] font-bold text-white flex items-center justify-between shadow cursor-pointer ${isDelayed ? 'bg-red-500' : 'bg-indigo-600'}"
                             style="left: ${left}%; width: ${width}%;"
                             title="${m.grade} ${m.sport} (${actualStart}-${actualEnd})">
                            <span class="truncate">${m.grade} ${m.sport}</span>
                            ${isDelayed ? `<span class="ml-1 bg-white text-red-600 rounded px-1 text-[9px]">+${m.delay}</span>` : ''}
                        </div>
                    `;
                });

                html += `
                        </div>
                    </div>
                `;
            });

            // 現在時間ラインコンテナ追加
            html += `<div id="ganttCurrentTimeLine" class="absolute top-8 bottom-0 w-0.5 bg-red-600 z-20 pointer-events-none shadow"><div class="bg-red-600 text-white text-[9px] px-1 py-0.5 rounded -ml-4 -mt-4 font-mono font-bold">現在</div></div>`;

            container.innerHTML = html;
        }

        // ガントチャートの現在時間指示線の位置更新
        function updateGanttCurrentTimeBar(now) {
            const line = document.getElementById('ganttCurrentTimeLine');
            if (!line) return;

            const startHour = 8;
            const endHour = 16;
            const totalMins = (endHour - startHour) * 60;

            const currentMins = (now.getHours() - startHour) * 60 + now.getMinutes() + (now.getSeconds() / 60);
            if (currentMins >= 0 && currentMins <= totalMins) {
                const percent = (currentMins / totalMins) * 100;
                line.style.left = `calc(6rem + (100% - 6rem) * ${percent / 100})`;
                line.style.display = 'block';
            } else {
                line.style.display = 'none';
            }
        }

