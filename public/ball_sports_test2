<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>第78回体育祭 球技日 進行管理＆本部ダッシュボード</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        @keyframes pulse-red {
            0%, 100% { background-color: rgba(239, 68, 68, 0.15); border-color: rgba(239, 68, 68, 0.8); }
            50% { background-color: rgba(239, 68, 68, 0.35); border-color: rgba(220, 38, 38, 1); }
        }
        .delay-alert {
            animation: pulse-red 2s infinite;
        }
        .high-contrast {
            background-color: #000000 !important;
            color: #ffffff !important;
        }
        .high-contrast .bg-card {
            background-color: #1a1a1a !important;
            border: 2px solid #ffffff !important;
            color: #ffffff !important;
        }
        .high-contrast .text-muted {
            color: #cccccc !important;
        }
        /* Marquee Text Animation */
        @keyframes marquee {
            0% { transform: translateX(100%); }
            100% { transform: translateX(-100%); }
        }
        .animate-marquee {
            display: inline-block;
            white-space: nowrap;
            animation: marquee 25s linear infinite;
        }
        .animate-marquee:hover {
            animation-play-state: paused;
        }
        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }
        ::-webkit-scrollbar-thumb {
            background: #a8a8a8;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #787878;
        }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 font-sans min-h-screen flex flex-col transition-colors duration-200" id="mainBody">

    <!-- 緊急アナウンス テロップバー -->
    <div id="announcementBar" class="bg-red-600 text-white font-bold py-1 px-4 overflow-hidden shadow-inner hidden">
        <div class="flex items-center max-w-7xl mx-auto">
            <span class="bg-white text-red-700 px-2 py-0.5 rounded text-xs mr-3 flex-shrink-0 font-extrabold flex items-center gap-1">
                <i class="fa-solid fa-triangle-exclamation"></i> 本部緊急連絡
            </span>
            <div class="overflow-hidden w-full relative h-6 flex items-center">
                <p id="announcementText" class="animate-marquee text-sm tracking-wide"></p>
            </div>
            <button onclick="dismissAnnouncement()" class="text-white hover:text-red-200 ml-2 flex-shrink-0">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    </div>

    <!-- ヘッダー -->
    <header class="bg-slate-900 text-white shadow-lg sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 py-3 flex flex-wrap justify-between items-center gap-4">
            <div class="flex items-center space-x-3">
                <div class="bg-indigo-600 p-2 rounded-lg text-white font-black text-xl shadow">
                    <i class="fa-solid fa-trophy"></i>
                </div>
                <div>
                    <h1 class="text-lg font-bold leading-none flex items-center gap-2">
                        第78回体育祭 <span class="bg-indigo-800 text-indigo-200 text-xs px-2 py-0.5 rounded-full font-semibold">球技日 進行管理</span>
                    </h1>
                    <p class="text-xs text-slate-400 mt-1">リアルタイム遅延調整 & 担当者・得点本部集計システム</p>
                </div>
            </div>

            <!-- 現在時間（ミリ秒表示） & 屋外モード切替 -->
            <div class="flex items-center space-x-4">
                <div class="bg-slate-800 border border-slate-700 px-3 py-1.5 rounded-lg text-right shadow-inner">
                    <div class="text-[10px] text-slate-400 uppercase tracking-wider font-semibold">現在時刻 (ミリ秒)</div>
                    <div id="clockDisplay" class="text-lg font-mono font-bold text-amber-400 tracking-wider">00:00:00.<span class="text-xs">000</span></div>
                </div>

                <button onclick="toggleHighContrast()" class="bg-slate-700 hover:bg-slate-600 text-xs text-slate-200 font-semibold py-2 px-3 rounded-lg border border-slate-600 transition flex items-center gap-1.5" title="日光下での視認性向上">
                    <i class="fa-solid fa-circle-half-stroke"></i>
                    <span class="hidden sm:inline">屋外高コントラスト</span>
                </button>
            </div>
        </div>

        <!-- ナビゲーションタブ -->
        <div class="bg-slate-800 border-t border-slate-700 px-4">
            <div class="max-w-7xl mx-auto flex space-x-1 overflow-x-auto text-sm font-medium">
                <button onclick="switchTab('timeline')" id="tab-timeline" class="tab-btn px-4 py-2.5 border-b-2 border-indigo-500 text-indigo-400 flex items-center gap-2 whitespace-nowrap font-bold">
                    <i class="fa-solid fa-calendar-days"></i> タイムテーブル・遅延管理
                </button>
                <button onclick="switchTab('gantt')" id="tab-gantt" class="tab-btn px-4 py-2.5 border-b-2 border-transparent text-slate-400 hover:text-slate-200 flex items-center gap-2 whitespace-nowrap">
                    <i class="fa-solid fa-chart-gantt"></i> ガントチャート視覚化
                </button>
                <button onclick="switchTab('scores')" id="tab-scores" class="tab-btn px-4 py-2.5 border-b-2 border-transparent text-slate-400 hover:text-slate-200 flex items-center gap-2 whitespace-nowrap">
                    <i class="fa-solid fa-ranking-star"></i> 結果入力 & ABCD組得点
                </button>
                <button onclick="switchTab('admin')" id="tab-admin" class="tab-btn px-4 py-2.5 border-b-2 border-transparent text-slate-400 hover:text-slate-200 flex items-center gap-2 whitespace-nowrap text-amber-400 font-bold">
                    <i class="fa-solid fa-lock"></i> 本部ダッシュボード
                </button>
            </div>
        </div>
    </header>

    <!-- メインコンテンツ -->
    <main class="max-w-7xl mx-auto px-4 py-6 flex-grow w-full">

        <!-- TAB 1: タイムテーブル・遅延管理 -->
        <section id="sec-timeline" class="space-y-6">
            <!-- 上部フィルター & コントロール -->
            <div class="bg-white rounded-xl shadow p-4 border border-slate-200 flex flex-wrap justify-between items-center gap-4 bg-card">
                <div class="flex flex-wrap items-center gap-3">
                    <span class="text-xs font-bold text-slate-500 uppercase">表示フィルター:</span>
                    <select id="courtFilter" onchange="renderSchedule()" class="bg-slate-50 border border-slate-300 rounded-lg text-sm px-3 py-1.5 font-medium text-slate-700 focus:ring-2 focus:ring-indigo-500 outline-none">
                        <option value="ALL">全コート（6コート）</option>
                        <option value="上グラ">上グラ (サッカー)</option>
                        <option value="下グラ">下グラ (サッカー/アルティメット/野球)</option>
                        <option value="体育館">体育館 (バスケ)</option>
                        <option value="ハード">ハードコート (バレー)</option>
                        <option value="オムニ">オムニコート (ドッジ/アルティメット)</option>
                        <option value="卓球場">卓球場 (卓球)</option>
                    </select>

                    <select id="statusFilter" onchange="renderSchedule()" class="bg-slate-50 border border-slate-300 rounded-lg text-sm px-3 py-1.5 font-medium text-slate-700 focus:ring-2 focus:ring-indigo-500 outline-none">
                        <option value="ALL">全てのステータス</option>
                        <option value="DELAYED">遅延発生中のみ</option>
                        <option value="ONGOING">進行中のみ</option>
                        <option value="UPCOMING">開始前</option>
                        <option value="FINISHED">終了済み</option>
                    </select>
                </div>

                <div class="flex items-center gap-2 text-xs text-slate-500 font-medium">
                    <span class="flex items-center gap-1"><span class="w-3 h-3 bg-emerald-500 rounded-full inline-block"></span> 進行中</span>
                    <span class="flex items-center gap-1"><span class="w-3 h-3 bg-red-500 rounded-full inline-block"></span> 遅延中</span>
                    <span class="flex items-center gap-1"><span class="w-3 h-3 bg-slate-300 rounded-full inline-block"></span> 終了</span>
                </div>
            </div>

            <!-- 試合タイムテーブルカードグリッド -->
            <div id="scheduleGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                <!-- JavaScriptで動的生成 -->
            </div>
        </section>

        <!-- TAB 2: ガントチャート視覚化 -->
        <section id="sec-gantt" class="hidden space-y-6">
            <div class="bg-white rounded-xl shadow p-5 border border-slate-200 bg-card">
                <div class="flex justify-between items-center mb-4">
                    <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                        <i class="fa-solid fa-chart-gantt text-indigo-600"></i> 各コート進行状況タイムライン (08:00 - 16:00)
                    </h2>
                    <div class="text-xs text-slate-500 flex items-center gap-2">
                        <span class="inline-block w-2.5 h-2.5 bg-red-500 rounded-full animate-ping"></span>
                        赤い垂直線は現在の時間を示します
                    </div>
                </div>

                <div class="overflow-x-auto relative">
                    <div id="ganttChartContainer" class="min-w-[800px] pt-6 pb-2">
                        <!-- JavaScriptで動的レンダリング -->
                    </div>
                </div>
            </div>
        </section>

        <!-- TAB 3: 結果入力 & ABCD組得点集計 -->
        <section id="sec-scores" class="hidden space-y-6">
            <!-- 総合得点順位ボード -->
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                <div id="card-score-A" class="bg-white rounded-xl shadow p-4 border-t-4 border-red-500 bg-card text-center">
                    <div class="text-xs font-bold text-red-600 uppercase tracking-wider">A 組</div>
                    <div class="text-3xl font-black text-slate-800 my-1" id="totalScoreA">0 <span class="text-xs font-normal text-slate-500">pt</span></div>
                    <div class="text-xs text-slate-500" id="rankA">順位: - 位</div>
                </div>
                <div id="card-score-B" class="bg-white rounded-xl shadow p-4 border-t-4 border-blue-500 bg-card text-center">
                    <div class="text-xs font-bold text-blue-600 uppercase tracking-wider">B 組</div>
                    <div class="text-3xl font-black text-slate-800 my-1" id="totalScoreB">0 <span class="text-xs font-normal text-slate-500">pt</span></div>
                    <div class="text-xs text-slate-500" id="rankB">順位: - 位</div>
                </div>
                <div id="card-score-C" class="bg-white rounded-xl shadow p-4 border-t-4 border-yellow-500 bg-card text-center">
                    <div class="text-xs font-bold text-yellow-600 uppercase tracking-wider">C 組</div>
                    <div class="text-3xl font-black text-slate-800 my-1" id="totalScoreC">0 <span class="text-xs font-normal text-slate-500">pt</span></div>
                    <div class="text-xs text-slate-500" id="rankC">順位: - 位</div>
                </div>
                <div id="card-score-D" class="bg-white rounded-xl shadow p-4 border-t-4 border-green-500 bg-card text-center">
                    <div class="text-xs font-bold text-green-600 uppercase tracking-wider">D 組</div>
                    <div class="text-3xl font-black text-slate-800 my-1" id="totalScoreD">0 <span class="text-xs font-normal text-slate-500">pt</span></div>
                    <div class="text-xs text-slate-500" id="rankD">順位: - 位</div>
                </div>
            </div>

            <!-- 学年・競技別 最終順位入力フォーム -->
            <div class="bg-white rounded-xl shadow border border-slate-200 overflow-hidden bg-card">
                <div class="bg-slate-800 text-white px-5 py-3.5 font-bold text-sm flex justify-between items-center">
                    <span><i class="fa-solid fa-list-check text-indigo-400 mr-2"></i> 学年・競技別 最終順位結果入力</span>
                    <span class="text-xs text-slate-400 font-normal">順位に応じて点数が自動加算されます</span>
                </div>
                <div class="p-5 overflow-x-auto">
                    <table class="w-full text-sm text-left">
                        <thead class="text-xs text-slate-600 uppercase bg-slate-100 border-b border-slate-200">
                            <tr>
                                <th class="px-4 py-3 font-bold">学年・競技</th>
                                <th class="px-4 py-3 font-bold text-amber-600">🥇 1位 (100pt)</th>
                                <th class="px-4 py-3 font-bold text-slate-500">🥈 2位 (75pt)</th>
                                <th class="px-4 py-3 font-bold text-amber-800">🥉 3位 (50pt)</th>
                                <th class="px-4 py-3 font-bold text-slate-400">4位 (25pt)</th>
                                <th class="px-4 py-3 font-bold text-center">操作</th>
                            </tr>
                        </thead>
                        <tbody id="scoreInputTableBody" class="divide-y divide-slate-200">
                            <!-- JavaScriptで動的生成 -->
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- TAB 4: 本部ダッシュボード (パスワード保護) -->
        <section id="sec-admin" class="hidden space-y-6">

            <!-- パスワード認証モーダル風表示 -->
            <div id="adminAuthOverlay" class="bg-white rounded-xl shadow-md p-8 border border-slate-200 text-center max-w-md mx-auto my-12 bg-card">
                <div class="w-12 h-12 bg-amber-100 text-amber-600 rounded-full flex items-center justify-center mx-auto mb-4 text-xl">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
                <h3 class="text-lg font-bold text-slate-800 mb-1">本部用タブ パスワード保護</h3>
                <p class="text-xs text-slate-500 mb-6">管理者用アクセスコードを入力してください（初期設定: <code class="bg-slate-100 px-1 py-0.5 rounded text-amber-700 font-bold">admin123</code>）</p>
                <div class="space-y-4">
                    <input type="password" id="adminPasswordInput" placeholder="パスワードを入力" class="w-full px-4 py-2 border border-slate-300 rounded-lg text-center font-bold tracking-widest focus:ring-2 focus:ring-amber-500 outline-none">
                    <button onclick="authenticateAdmin()" class="w-full bg-amber-600 hover:bg-amber-700 text-white font-bold py-2.5 rounded-lg transition shadow">
                        認証してログイン
                    </button>
                    <p id="authError" class="text-xs text-red-600 hidden font-semibold">パスワードが正しくありません</p>
                </div>
            </div>

            <!-- 認証後表示される本部ダッシュボード -->
            <div id="adminContent" class="hidden space-y-6">

                <div class="flex flex-wrap justify-between items-center bg-slate-900 text-white p-4 rounded-xl shadow gap-4">
                    <div class="flex items-center space-x-3">
                        <span class="bg-amber-500 text-slate-900 px-2.5 py-1 rounded font-black text-xs uppercase">本部モード</span>
                        <h2 class="text-base font-bold">全コート統合進行モニタリング & 調整</h2>
                    </div>
                    <div class="flex items-center gap-2">
                        <button onclick="lockAdmin()" class="bg-slate-800 hover:bg-slate-700 text-xs px-3 py-1.5 rounded text-slate-300 border border-slate-700 transition">
                            <i class="fa-solid fa-lock mr-1"></i> ロック
                        </button>
                    </div>
                </div>

                <!-- リアルタイム進行ステータス & 得点グラフ -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <!-- 左: 遅延サマリー & 一括調整 -->
                    <div class="space-y-6">
                        <div class="bg-white rounded-xl shadow p-5 border border-slate-200 bg-card">
                            <h3 class="text-sm font-bold text-slate-800 mb-3 flex items-center justify-between">
                                <span><i class="fa-solid fa-triangle-exclamation text-red-500 mr-2"></i>コート別 遅延ステータス</span>
                                <span id="totalDelayBadge" class="bg-red-100 text-red-700 text-xs px-2 py-0.5 rounded-full font-bold">遅延合計: 0分</span>
                            </h3>
                            <div id="courtDelaySummary" class="space-y-2 text-xs">
                                <!-- JavaScriptで動的ロード -->
                            </div>
                        </div>

                        <!-- 一括・連動遅延調整コントロール -->
                        <div class="bg-white rounded-xl shadow p-5 border border-slate-200 bg-card space-y-4">
                            <h3 class="text-sm font-bold text-slate-800 flex items-center gap-2">
                                <i class="fa-solid fa-sliders text-indigo-600"></i> カスケード(連動) 遅延一括調整
                            </h3>
                            <p class="text-xs text-slate-500">指定したコートの指定試合以降をすべて一律で遅延調整します。</p>

                            <div class="space-y-3 pt-1">
                                <div>
                                    <label class="text-xs font-bold text-slate-600">対象コート:</label>
                                    <select id="cascadeCourtSelect" class="w-full mt-1 bg-slate-50 border border-slate-300 rounded text-xs p-2">
                                        <option value="上グラ">上グラ</option>
                                        <option value="下グラ">下グラ</option>
                                        <option value="体育館">体育館</option>
                                        <option value="ハード">ハード</option>
                                        <option value="オムニ">オムニ</option>
                                        <option value="卓球場">卓球場</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="text-xs font-bold text-slate-600">調整時間 (分):</label>
                                    <div class="flex items-center gap-2 mt-1">
                                        <button onclick="applyCascadeDelay(-5)" class="flex-1 bg-slate-100 hover:bg-slate-200 font-bold py-1.5 rounded border border-slate-300 text-xs text-slate-700">-5分</button>
                                        <button onclick="applyCascadeDelay(-1)" class="flex-1 bg-slate-100 hover:bg-slate-200 font-bold py-1.5 rounded border border-slate-300 text-xs text-slate-700">-1分</button>
                                        <button onclick="applyCascadeDelay(1)" class="flex-1 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-bold py-1.5 rounded border border-indigo-200 text-xs">+1分</button>
                                        <button onclick="applyCascadeDelay(5)" class="flex-1 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-bold py-1.5 rounded border border-indigo-200 text-xs">+5分</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 緊急アナウンス発信パネル -->
                        <div class="bg-white rounded-xl shadow p-5 border border-slate-200 bg-card space-y-3">
                            <h3 class="text-sm font-bold text-slate-800 flex items-center gap-2">
                                <i class="fa-solid fa-bullhorn text-red-500"></i> 本部緊急アナウンス発信
                            </h3>
                            <textarea id="announcementInput" rows="2" placeholder="全体画面上部に表示するアナウンス文章を入力..." class="w-full p-2.5 text-xs border border-slate-300 rounded-lg focus:ring-2 focus:ring-red-500 outline-none"></textarea>
                            <div class="flex gap-2">
                                <button onclick="broadcastAnnouncement()" class="flex-1 bg-red-600 hover:bg-red-700 text-white font-bold py-1.5 px-3 rounded text-xs transition">
                                    テロップ表示開始
                                </button>
                                <button onclick="clearAnnouncement()" class="bg-slate-200 hover:bg-slate-300 text-slate-700 font-bold py-1.5 px-3 rounded text-xs transition">
                                    消去
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- 右: 組別総得点グラフ & バックアップ機能 -->
                    <div class="lg:col-span-2 space-y-6">
                        <div class="bg-white rounded-xl shadow p-5 border border-slate-200 bg-card">
                            <h3 class="text-sm font-bold text-slate-800 mb-4 flex items-center gap-2">
                                <i class="fa-solid fa-chart-column text-indigo-600"></i> ABCD組 リアルタイム総得点チャート
                            </h3>
                            <div class="h-64 relative">
                                <canvas id="scoreChart"></canvas>
                            </div>
                        </div>

                        <div class="bg-white rounded-xl shadow p-5 border border-slate-200 bg-card space-y-4">
                            <h3 class="text-sm font-bold text-slate-800 flex items-center gap-2">
                                <i class="fa-solid fa-database text-slate-600"></i> データ管理 & バックアップ
                            </h3>
                            <p class="text-xs text-slate-500">現在の進行・遅延・担当者・得点データをJSON形式で書き出し/読み込みできます。</p>
                            <div class="flex flex-wrap gap-3">
                                <button onclick="exportData()" class="bg-slate-800 hover:bg-slate-700 text-white text-xs font-bold py-2 px-4 rounded-lg transition flex items-center gap-2">
                                    <i class="fa-solid fa-download"></i> JSONバックアップ出力
                                </button>
                                <label class="bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-300 text-xs font-bold py-2 px-4 rounded-lg transition cursor-pointer flex items-center gap-2">
                                    <i class="fa-solid fa-upload"></i> JSONデータ復元
                                    <input type="file" id="importFile" onchange="importData(event)" class="hidden" accept=".json">
                                </label>
                                <button onclick="resetAllData()" class="bg-red-50 hover:bg-red-100 text-red-700 border border-red-200 text-xs font-bold py-2 px-4 rounded-lg transition ml-auto flex items-center gap-1">
                                    <i class="fa-solid fa-rotate-left"></i> 初期設定にリセット
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

    </main>

    <!-- モーダル: 試合担当者＆詳細編集 -->
    <div id="editModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
        <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full overflow-hidden border border-slate-200 bg-card">
            <div class="bg-slate-900 text-white px-6 py-4 flex justify-between items-center">
                <h3 class="font-bold text-base flex items-center gap-2" id="modalTitle">
                    <i class="fa-solid fa-pen-to-square text-indigo-400"></i> 試合情報・担当者設定
                </h3>
                <button onclick="closeModal()" class="text-slate-400 hover:text-white">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>
            <div class="p-6 space-y-4">
                <input type="hidden" id="modalMatchId">

                <div class="bg-indigo-50 border border-indigo-100 rounded-lg p-3 text-xs space-y-1">
                    <div class="font-bold text-indigo-900" id="modalMatchDetail">種目・学年</div>
