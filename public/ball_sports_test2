        function createClassSelect(index, rankKey, selectedVal) {
            const classes = ["", "A", "B", "C", "D"];
            let options = classes.map(c => `<option value="${c}" ${c === selectedVal ? 'selected' : ''}>${c ? c + '組' : '未確定'}</option>`).join('');
            return `<select id="score_${index}_${rankKey}" class="bg-slate-50 border border-slate-300 rounded text-xs px-2 py-1 font-bold text-slate-700 focus:ring-2 focus:ring-indigo-500">${options}</select>`;
        }

        // 順位データの更新＆点数集計
        function updateScores(index) {
            appState.scores[index].first = document.getElementById(`score_${index}_first`).value;
            appState.scores[index].second = document.getElementById(`score_${index}_second`).value;
            appState.scores[index].third = document.getElementById(`score_${index}_third`).value;
            appState.scores[index].fourth = document.getElementById(`score_${index}_fourth`).value;

            saveState();
            calculateAndRenderTotalScores();
        }

        // 総合得点計算（1位:100pt, 2位:75pt, 3位:50pt, 4位:25pt）
        function calculateAndRenderTotalScores() {
            const totals = { A: 0, B: 0, C: 0, D: 0 };

            appState.scores.forEach(s => {
                if (s.first && totals[s.first] !== undefined) totals[s.first] += 100;
                if (s.second && totals[s.second] !== undefined) totals[s.second] += 75;
                if (s.third && totals[s.third] !== undefined) totals[s.third] += 50;
                if (s.fourth && totals[s.fourth] !== undefined) totals[s.fourth] += 25;
            });

            document.getElementById('totalScoreA').innerHTML = `${totals.A} <span class="text-xs font-normal text-slate-500">pt</span>`;
            document.getElementById('totalScoreB').innerHTML = `${totals.B} <span class="text-xs font-normal text-slate-500">pt</span>`;
            document.getElementById('totalScoreC').innerHTML = `${totals.C} <span class="text-xs font-normal text-slate-500">pt</span>`;
            document.getElementById('totalScoreD').innerHTML = `${totals.D} <span class="text-xs font-normal text-slate-500">pt</span>`;

            // 順位付け
            const sorted = Object.keys(totals).sort((a, b) => totals[b] - totals[a]);
            sorted.forEach((team, rankIndex) => {
                document.getElementById(`rank${team}`).innerText = `現在総合: ${rankIndex + 1}位`;
            });

            if (scoreChartInstance) {
                scoreChartInstance.data.datasets[0].data = [totals.A, totals.B, totals.C, totals.D];
                scoreChartInstance.update();
            }
        }

        // モーダル編集画面
        function openModal(matchId) {
            const match = appState.schedule.find(m => m.id === matchId);
            if (!match) return;

            document.getElementById('modalMatchId').value = match.id;
            document.getElementById('modalMatchDetail').innerText = `${match.grade} ${match.sport}`;
            document.getElementById('modalCourtDetail').innerText = `場所: ${match.court}`;
            document.getElementById('modalTimeDetail').innerText = `予定時刻: ${match.start} - ${match.end}`;

            document.getElementById('inputReferee').value = match.referee;
            document.getElementById('inputStaff').value = match.staff;
            document.getElementById('inputAttendance').value = match.attendance;
            document.getElementById('inputDelayMinutes').value = match.delay;
            document.getElementById('checkCascade').checked = false;

            document.getElementById('editModal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('editModal').classList.add('hidden');
        }

        function saveModalData() {
            const matchId = document.getElementById('modalMatchId').value;
            const match = appState.schedule.find(m => m.id === matchId);

            if (match) {
                match.referee = document.getElementById('inputReferee').value;
                match.staff = document.getElementById('inputStaff').value;
                match.attendance = document.getElementById('inputAttendance').value;

                const newDelay = parseInt(document.getElementById('inputDelayMinutes').value) || 0;
                const delayDiff = newDelay - match.delay;
                const isCascade = document.getElementById('checkCascade').checked;

                if (isCascade && delayDiff !== 0) {
                    // 後続試合連動調整
                    appState.schedule.filter(m => m.court === match.court && m.start >= match.start).forEach(m => {
                        m.delay = Math.max(0, m.delay + delayDiff);
                    });
                } else {
                    match.delay = newDelay;
                }

                saveState();
                renderSchedule();
                closeModal();
            }
        }

        // 本部認証認証プロセス
        function authenticateAdmin() {
            const pass = document.getElementById('adminPasswordInput').value;
            if (pass === 'admin123') {
                appState.isAdmin = true;
                document.getElementById('adminAuthOverlay').classList.add('hidden');
                document.getElementById('adminContent').classList.remove('hidden');
                updateAdminDashboard();
                initChart();
            } else {
                document.getElementById('authError').classList.remove('hidden');
            }
        }

        function lockAdmin() {
            appState.isAdmin = false;
            document.getElementById('adminAuthOverlay').classList.remove('hidden');
            document.getElementById('adminContent').classList.add('hidden');
            document.getElementById('adminPasswordInput').value = '';
        }

        // 本部ダッシュボード情報更新
        function updateAdminDashboard() {
            if (!appState.isAdmin) return;

            const summaryEl = document.getElementById('courtDelaySummary');
            const courts = ["上グラ", "下グラ", "体育館", "ハード", "オムニ", "卓球場"];
            let totalDelaySum = 0;
            let html = '';

            courts.forEach(court => {
                const courtMatches = appState.schedule.filter(m => m.court === court);
                const courtDelayMax = Math.max(0, ...courtMatches.map(m => m.delay));
                totalDelaySum += courtDelayMax;

                html += `
                    <div class="flex justify-between items-center p-2 rounded ${courtDelayMax > 0 ? 'bg-red-50 text-red-700 border border-red-200' : 'bg-slate-50 text-slate-700'}">
                        <span class="font-bold">${court}</span>
                        <span class="font-mono font-bold">${courtDelayMax > 0 ? `+${courtDelayMax}分遅延` : '正常進行'}</span>
                    </div>
                `;
            });

            summaryEl.innerHTML = html;
            document.getElementById('totalDelayBadge').innerText = `全体遅延影響: +${totalDelaySum}分`;
        }

        // 連動（カスケード）遅延調整発動
        function applyCascadeDelay(minutes) {
            const court = document.getElementById('cascadeCourtSelect').value;
            appState.schedule.filter(m => m.court === court).forEach(m => {
                m.delay = Math.max(0, m.delay + minutes);
            });
            saveState();
            renderSchedule();
            updateAdminDashboard();
        }

        // 緊急アナウンス送信
        function broadcastAnnouncement() {
            const text = document.getElementById('announcementInput').value;
            if (!text) return;
            appState.announcement = text;
            saveState();
            showAnnouncement(text);
        }

        function clearAnnouncement() {
            appState.announcement = "";
            saveState();
            document.getElementById('announcementBar').classList.add('hidden');
            document.getElementById('announcementInput').value = "";
        }

        function showAnnouncement(text) {
            document.getElementById('announcementText').innerText = text;
            document.getElementById('announcementBar').classList.remove('hidden');
        }

        function dismissAnnouncement() {
            document.getElementById('announcementBar').classList.add('hidden');
        }

        // 得点グラフ初期化 (Chart.js)
        function initChart() {
            const ctx = document.getElementById('scoreChart').getContext('2d');
            if (scoreChartInstance) scoreChartInstance.destroy();

            scoreChartInstance = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ['A組', 'B組', 'C組', 'D組'],
                    datasets: [{
                        label: '総得点 (pt)',
                        data: [0, 0, 0, 0],
                        backgroundColor: [
                            'rgba(239, 68, 68, 0.7)',
                            'rgba(59, 130, 246, 0.7)',
                            'rgba(234, 179, 8, 0.7)',
                            'rgba(34, 197, 94, 0.7)'
                        ],
                        borderColor: [
                            'rgb(239, 68, 68)',
                            'rgb(59, 130, 246)',
                            'rgb(234, 179, 8)',
                            'rgb(34, 197, 94)'
                        ],
                        borderWidth: 2,
                        borderRadius: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: { y: { beginAtZero: true } }
                }
            });

            calculateAndRenderTotalScores();
        }

        // 屋外高コントラスト表示切替
        function toggleHighContrast() {
            document.getElementById('mainBody').classList.toggle('high-contrast');
        }

        // データエクスポート (JSON)
        function exportData() {
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(appState, null, 2));
            const dlAnchorElem = document.createElement('a');
            dlAnchorElem.setAttribute("href", dataStr);
            dlAnchorElem.setAttribute("download", `gym78_backup_${new Date().toISOString().slice(0,10)}.json`);
            dlAnchorElem.click();
        }

        // データインポート (JSON)
        function importData(event) {
            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const imported = JSON.parse(e.target.result);
                    if (imported.schedule && imported.scores) {
                        appState = imported;
                        saveState();
                        location.reload();
                    }
                } catch(err) {
                    alert("無効なJSONファイルです");
                }
            };
            reader.readAsText(event.target.files[0]);
        }

        // 完全リセット
        function resetAllData() {
            if (confirm("全ての進行・遅延・担当者・得点データを初期化しますか？")) {
                localStorage.clear();
                location.reload();
            }
        }
    </script>
</body>
</html>
