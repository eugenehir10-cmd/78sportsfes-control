            { id: 105, court: '上グラ', grade: '高2', sport: 'サッカー', startTime: '13:15', duration: 67, delayMinutes: 0, status: 'PLANNED', referee: '', eventStaff: '', attendanceStaff: '' },
            { id: 106, court: '上グラ', grade: '高3', sport: 'サッカー', startTime: '14:30', duration: 67, delayMinutes: 0, status: 'PLANNED', referee: '', eventStaff: '', attendanceStaff: '' },

            // 下グラ
