        // 1分単位クイック調整
        function quickAdjustDelay(matchId, delta) {
            const match = matches.find(m => m.id === matchId);
            if (match) {
                match.delayMinutes = Math.max(0, match.delayMinutes + delta);
                saveData();
                renderMatchesCards();
            }
        }

        // モーダルオープン
        function openModal(matchId) {
            editingMatchId = matchId;
            const m = matches.find(x => x.id === matchId);
            if (!m) return;

            document.getElementById('modal-court-badge').innerText = m.court;
            document.getElementById('modal-match-title').innerText = `${m.grade} ${m.sport}`;
            document.getElementById('modal-match-time').innerText = `定刻: ${m.startTime} (${m.duration}分)`;
            document.getElementById('modal-delay-display').innerText = `+${m.delayMinutes}分`;
            document.getElementById('modal-referee').value = m.referee || '';
            document.getElementById('modal-event').value = m.eventStaff || '';
            document.getElementById('modal-attendance').value = m.attendanceStaff || '';
            document.getElementById('modal-status').value = m.status;
            document.getElementById('modal-cascade-delay').checked = false;

            document.getElementById('edit-modal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('edit-modal').classList.add('hidden');
            editingMatchId = null;
        }

        function adjustModalDelay(delta) {
            const display = document.getElementById('modal-delay-display');
            let current = parseInt(display.innerText.replace(/[^0-9-]/g, '')) || 0;
            current = Math.max(0, current + delta);
            display.innerText = `+${current}分`;
        }

        function saveModalChanges() {
            if (!editingMatchId) return;
            const match = matches.find(m => m.id === editingMatchId);
            if (!match) return;

            const newDelay = parseInt(document.getElementById('modal-delay-display').innerText.replace(/[^0-9-]/g, '')) || 0;
            const delayDiff = newDelay - match.delayMinutes;
            const isCascade = document.getElementById('modal-cascade-delay').checked;

            match.delayMinutes = newDelay;
            match.referee = document.getElementById('modal-referee').value;
            match.eventStaff = document.getElementById('modal-event').value;
            match.attendanceStaff = document.getElementById('modal-attendance').value;
            match.status = document.getElementById('modal-status').value;

            // 後続一括連動調整
            if (isCascade && delayDiff !== 0) {
                matches.forEach(other => {
                    if (other.court === match.court && other.id !== match.id) {
                        const [m1H, m1M] = match.startTime.split(':').map(Number);
                        const [m2H, m2M] = other.startTime.split(':').map(Number);
                        if (m2H * 60 + m2M > m1H * 60 + m1M) {
                            other.delayMinutes = Math.max(0, other.delayMinutes + delayDiff);
                        }
                    }
                });
            }

            saveData();
            closeModal();
            renderMatchesCards();
        }

        // タブ2: タイムライン（ガントチャート）描画
        function renderTimeline() {
            const container = document.getElementById('timeline-chart-container');
            container.innerHTML = '';

            const courts = ['上グラ', '下グラ', '体育館', 'ハード', 'オムニ', '卓球場'];
            const startHour = 8;
            const endHour = 16;
            const totalMinutes = (endHour - startHour) * 60;

            // 時間軸ヘッダー
            let headerHtml = `<div class="flex border-b border-slate-800 pb-1 mb-2 text-[10px] text-slate-400 font-mono">
                <div class="w-20 font-bold text-slate-300">コート</div><div class="flex-1 flex justify-between">`;
            for (let h = startHour; h <= endHour; h++) {
                headerHtml += `<span>${String(h).padStart(2, '0')}:00</span>`;
            }
            headerHtml += `</div></div>`;
            container.insertAdjacentHTML('beforeend', headerHtml);

            // 赤線の現在時間マーカー
            const nowMarker = document.createElement('div');
            nowMarker.id = 'timeline-now-line';
            nowMarker.className = 'absolute top-0 bottom-0 w-0.5 bg-red-500 z-10 pointer-events-none shadow-[0_0_8px_#ef4444]';
            container.appendChild(nowMarker);

            // コートごと行
            courts.forEach(court => {
                const courtMatches = matches.filter(m => m.court === court);
                let rowHtml = `<div class="flex items-center my-2 h-8 relative">
                    <div class="w-20 text-xs font-bold text-blue-400 truncate">${court}</div>
                    <div class="flex-1 bg-slate-950/80 rounded h-full relative border border-slate-800/60 overflow-hidden">`;

                courtMatches.forEach(m => {
                    const [h, min] = m.startTime.split(':').map(Number);
                    const startMins = (h - startHour) * 60 + min + m.delayMinutes;
                    const leftPct = (startMins / totalMinutes) * 100;
                    const widthPct = (m.duration / totalMinutes) * 100;

                    let bgClass = 'bg-blue-600/80 border-blue-400';
                    if (m.delayMinutes > 0) bgClass = 'bg-red-600/80 border-red-400 animate-pulse';
                    if (m.status === 'FINISHED') bgClass = 'bg-slate-700/80 border-slate-500';

                    rowHtml += `<div onclick="openModal(${m.id})" class="absolute top-1 bottom-1 ${bgClass} border rounded text-[9px] text-white font-bold px-1 truncate cursor-pointer shadow flex items-center" style="left: ${leftPct}%; width: ${widthPct}%;">
                        ${m.grade} ${m.sport}
                    </div>`;
                });

                rowHtml += `</div></div>`;
                container.insertAdjacentHTML('beforeend', rowHtml);
            });

            updateCurrentTimeMarker();
        }

        function updateCurrentTimeMarker() {
            const line = document.getElementById('timeline-now-line');
            if (!line) return;

            const now = new Date();
            const hours = now.getHours();
            const mins = now.getMinutes();

            const startHour = 8;
            const endHour = 16;
            const totalMinutes = (endHour - startHour) * 60;
            const currentMins = (hours - startHour) * 60 + mins;

            if (currentMins >= 0 && currentMins <= totalMinutes) {
                const pct = (currentMins / totalMinutes) * 100;
                line.style.left = `calc(5rem + ${pct}% * (100% - 5rem) / 100)`;
                line.style.display = 'block';
            } else {
                line.style.display = 'none';
            }
        }

