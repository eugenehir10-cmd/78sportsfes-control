<!DOCTYPE html>
<html lang="ja" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>第78回体育祭 球技日 進行管理システム</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        darkbg: '#090d16',
                        darkcard: '#131b2e',
                        darkborder: '#2a364f',
                        accent: '#3b82f6',
                        delayred: '#ef4444',
                        successgreen: '#10b981'
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome & Chart.js -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background-color: #090d16;
            color: #f1f5f9;
        }
        /* 遅延時の点滅アニメーション */
        @keyframes pulse-red {
            0%, 100% { background-color: rgba(239, 68, 68, 0.2); border-color: #ef4444; }
            50% { background-color: rgba(239, 68, 68, 0.45); border-color: #f87171; }
        }
        .delay-alert-active {
            animation: pulse-red 1.5s infinite;
        }
        /* スクロールバーカスタマイズ */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #0f172a;
        }
        ::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 4px;
        }
        /* 高コントラストモード */
        .high-contrast {
            background-color: #000000 !important;
            color: #ffffff !important;
        }
        .high-contrast .bg-card {
            background-color: #111111 !important;
            border-color: #ffffff !important;
        }
        .high-contrast button {
            border-width: 2px !important;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col">

    <!-- 緊急アナウンス・テロップバー -->
    <div id="ticker-container" class="hidden bg-red-600 text-white px-4 py-1.5 font-bold text-sm overflow-hidden whitespace-nowrap shadow-md">
        <div id="ticker-text" class="inline-block animate-marquee pl-[100%]"></div>
    </div>

    <!-- ヘッダー -->
    <header class="bg-slate-900 border-b border-slate-800 sticky top-0 z-40 shadow-xl">
        <div class="max-w-7xl mx-auto px-3 sm:px-6 py-2.5 flex flex-wrap items-center justify-between gap-2">
            <div class="flex items-center space-x-3">
                <div class="bg-blue-600 text-white font-black rounded-lg px-2.5 py-1 text-lg shadow-lg">78th</div>
                <div>
                    <h1 class="text-base sm:text-xl font-bold tracking-tight text-white flex items-center gap-2">
                        体育祭 球技日 進行・得点管理
                        <span class="text-xs font-normal bg-slate-800 text-blue-400 px-2 py-0.5 rounded border border-blue-500/30">黒基調Ver</span>
                    </h1>
                </div>
            </div>

            <!-- 時間 & モード切り替え -->
            <div class="flex items-center space-x-2 text-xs sm:text-sm">
                <button id="contrast-toggle-btn" onclick="toggleContrast()" class="bg-slate-800 hover:bg-slate-700 text-slate-200 px-2.5 py-1.5 rounded-lg border border-slate-700 transition flex items-center gap-1.5">
                    <i class="fa-solid fa-sun text-yellow-400"></i>
                    <span class="hidden sm:inline">高コントラスト</span>
                </button>
                <div class="bg-slate-950 px-3 py-1.5 rounded-lg border border-slate-800 font-mono text-blue-400 font-semibold shadow-inner flex items-center gap-2">
                    <i class="fa-regular fa-clock text-slate-400"></i>
                    <span id="header-clock">00:00:00</span>
                </div>
            </div>
        </div>

        <!-- タブナビゲーション -->
        <div class="max-w-7xl mx-auto px-2 sm:px-6 flex space-x-1 border-t border-slate-800/80 overflow-x-auto">
            <button onclick="switchTab('cards')" id="tab-btn-cards" class="tab-btn active text-blue-400 border-b-2 border-blue-500 py-2.5 px-3 font-semibold text-xs sm:text-sm flex items-center gap-2 whitespace-nowrap">
                <i class="fa-solid fa-list-check"></i> コート別タイムテーブル
            </button>
            <button onclick="switchTab('timeline')" id="tab-btn-timeline" class="tab-btn text-slate-400 hover:text-slate-200 py-2.5 px-3 font-medium text-xs sm:text-sm flex items-center gap-2 whitespace-nowrap">
                <i class="fa-solid fa-chart-gantt"></i> 全体タイムライン (ガント)
            </button>
            <button onclick="switchTab('scoring')" id="tab-btn-scoring" class="tab-btn text-slate-400 hover:text-slate-200 py-2.5 px-3 font-medium text-xs sm:text-sm flex items-center gap-2 whitespace-nowrap">
                <i class="fa-solid fa-trophy text-amber-400"></i> 対戦・結果・総合得点
            </button>
            <button onclick="switchTab('admin')" id="tab-btn-admin" class="tab-btn text-slate-400 hover:text-slate-200 py-2.5 px-3 font-medium text-xs sm:text-sm flex items-center gap-2 whitespace-nowrap ml-auto">
                <i class="fa-solid fa-shield-halved text-purple-400"></i> 本部ダッシュボード
            </button>
        </div>
    </header>

    <!-- メインコンテンツ -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-2 sm:px-6 py-4 space-y-4">

        <!-- ================= タブ1: コート別タイムテーブル ================= -->
        <section id="tab-cards" class="tab-content space-y-4">
            <!-- フィルタ & 一括操作 -->
            <div class="bg-slate-900 border border-slate-800 rounded-xl p-3 flex flex-wrap items-center justify-between gap-3 shadow-lg">
                <div class="flex flex-wrap items-center gap-2">
                    <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">コート絞り込み:</span>
                    <button onclick="filterCourt('ALL')" class="court-filter-btn bg-blue-600 text-white text-xs px-3 py-1.5 rounded-lg font-medium transition shadow">すべて</button>
                    <button onclick="filterCourt('上グラ')" class="court-filter-btn bg-slate-800 text-slate-300 hover:bg-slate-700 text-xs px-3 py-1.5 rounded-lg font-medium transition border border-slate-700">上グラ</button>
                    <button onclick="filterCourt('下グラ')" class="court-filter-btn bg-slate-800 text-slate-300 hover:bg-slate-700 text-xs px-3 py-1.5 rounded-lg font-medium transition border border-slate-700">下グラ</button>
                    <button onclick="filterCourt('体育館')" class="court-filter-btn bg-slate-800 text-slate-300 hover:bg-slate-700 text-xs px-3 py-1.5 rounded-lg font-medium transition border border-slate-700">体育館</button>
                    <button onclick="filterCourt('ハード')" class="court-filter-btn bg-slate-800 text-slate-300 hover:bg-slate-700 text-xs px-3 py-1.5 rounded-lg font-medium transition border border-slate-700">ハード</button>
                    <button onclick="filterCourt('オムニ')" class="court-filter-btn bg-slate-800 text-slate-300 hover:bg-slate-700 text-xs px-3 py-1.5 rounded-lg font-medium transition border border-slate-700">オムニ</button>
                    <button onclick="filterCourt('卓球場')" class="court-filter-btn bg-slate-800 text-slate-300 hover:bg-slate-700 text-xs px-3 py-1.5 rounded-lg font-medium transition border border-slate-700">卓球場</button>
                </div>
                <div class="text-xs text-slate-400 flex items-center gap-3">
                    <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span> 進行中</span>
                    <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-red-500"></span> 遅延発生</span>
                    <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-slate-600"></span> 終了/予定</span>
                </div>
            </div>

            <!-- 試合カードグリッド -->
            <div id="cards-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                <!-- JS動的生成 -->
            </div>
        </section>

        <!-- ================= タブ2: 全体タイムライン ================= -->
        <section id="tab-timeline" class="tab-content hidden space-y-4">
            <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 shadow-lg overflow-x-auto">
                <div class="flex items-center justify-between mb-3 min-w-[700px]">
                    <h2 class="text-sm font-bold text-slate-200 flex items-center gap-2">
                        <i class="fa-solid fa-clock text-blue-400"></i> 全コート進行状況（ガントチャート）
                    </h2>
                    <span class="text-xs text-slate-400">赤垂直線 ＝ 現在時刻</span>
                </div>
                <!-- ガントチャートコンテナ -->
                <div id="timeline-chart-container" class="relative min-w-[800px] border-t border-slate-800 pt-2">
                    <!-- JS動的描画 -->
                </div>
            </div>
        </section>

        <!-- ================= タブ3: 対戦・結果・総合得点 ================= -->
        <section id="tab-scoring" class="tab-content hidden space-y-4">
            <!-- 組別総合得点サマリー -->
            <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 shadow-lg">
                <h2 class="text-base font-bold text-white mb-3 flex items-center gap-2">
                    <i class="fa-solid fa-trophy text-amber-400"></i> A・B・C・D組 総合得点リアルタイム集計
                </h2>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4">
                    <div class="bg-gradient-to-br from-red-950/60 to-slate-900 border border-red-500/30 rounded-xl p-3 text-center shadow">
                        <div class="text-xs font-bold text-red-400">A組</div>
                        <div id="score-A" class="text-2xl sm:text-3xl font-black text-white my-1">0 <span class="text-xs font-normal text-slate-400">pt</span></div>
                        <div id="rank-A" class="text-xs text-slate-400">順位: -位</div>
                    </div>
                    <div class="bg-gradient-to-br from-blue-950/60 to-slate-900 border border-blue-500/30 rounded-xl p-3 text-center shadow">
                        <div class="text-xs font-bold text-blue-400">B組</div>
                        <div id="score-B" class="text-2xl sm:text-3xl font-black text-white my-1">0 <span class="text-xs font-normal text-slate-400">pt</span></div>
                        <div id="rank-B" class="text-xs text-slate-400">順位: -位</div>
                    </div>
                    <div class="bg-gradient-to-br from-amber-950/60 to-slate-900 border border-amber-500/30 rounded-xl p-3 text-center shadow">
                        <div class="text-xs font-bold text-amber-400">C組</div>
                        <div id="score-C" class="text-2xl sm:text-3xl font-black text-white my-1">0 <span class="text-xs font-normal text-slate-400">pt</span></div>
                        <div id="rank-C" class="text-xs text-slate-400">順位: -位</div>
                    </div>
                    <div class="bg-gradient-to-br from-emerald-950/60 to-slate-900 border border-emerald-500/30 rounded-xl p-3 text-center shadow">
                        <div class="text-xs font-bold text-emerald-400">D組</div>
                        <div id="score-D" class="text-2xl sm:text-3xl font-black text-white my-1">0 <span class="text-xs font-normal text-slate-400">pt</span></div>
                        <div id="rank-D" class="text-xs text-slate-400">順位: -位</div>
                    </div>
                </div>

                <!-- グラフ -->
                <div class="h-44 w-full bg-slate-950/50 rounded-lg p-2 border border-slate-800">
                    <canvas id="scoreChart"></canvas>
                </div>
            </div>

            <!-- 学年・競技別 順位登録パネル -->
            <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 shadow-lg">
                <h3 class="text-sm font-bold text-slate-200 mb-3 flex items-center gap-2">
                    <i class="fa-solid fa-pen-to-square text-blue-400"></i> 各競技の最終順位決定・点数反映
                </h3>
                <div id="score-input-list" class="space-y-3">
                    <!-- JSで各競技の順位入力フォーム生成 -->
                </div>
            </div>
        </section>

        <!-- ================= タブ4: 本部ダッシュボード ================= -->
        <section id="tab-admin" class="tab-content hidden space-y-4">
            <!-- ロック解除画面 -->
            <div id="admin-lock-screen" class="bg-slate-900 border border-slate-800 rounded-xl p-8 max-w-md mx-auto text-center space-y-4 shadow-2xl my-8">
                <div class="w-16 h-16 bg-purple-500/10 text-purple-400 rounded-full flex items-center justify-center mx-auto text-2xl border border-purple-500/20">
                    <i class="fa-solid fa-lock"></i>
                </div>
                <div>
                    <h2 class="text-lg font-bold text-white">本部用エリア（認証が必要）</h2>
                    <p class="text-xs text-slate-400 mt-1">本部スタッフ専用の管理機能です</p>
                </div>
                <div class="space-y-2">
                    <input type="password" id="admin-password" placeholder="パスワードを入力 (初期: admin123)" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-center text-white focus:outline-none focus:border-purple-500 transition">
                    <button onclick="unlockAdmin()" class="w-full bg-purple-600 hover:bg-purple-500 text-white font-bold py-2 rounded-lg text-sm transition shadow-lg">ログイン</button>
                </div>
            </div>

            <!-- 本部ダッシュボード本体 (ログイン後) -->
            <div id="admin-content" class="hidden space-y-4">
                <!-- ミリ秒時計 & 全体ステータス -->
                <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 shadow-lg flex flex-wrap items-center justify-between gap-4">
                    <div>
                        <span class="text-xs text-slate-400 block">本部リアルタイム基準時刻 (ミリ秒表示)</span>
                        <div id="admin-ms-clock" class="text-2xl sm:text-4xl font-black font-mono text-purple-400 tracking-wider">00:00:00.000</div>
                    </div>
                    <div class="flex items-center gap-2">
                        <button onclick="lockAdmin()" class="bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs px-3 py-2 rounded-lg border border-slate-700">
                            <i class="fa-solid fa-lock me-1"></i> ロックする
                        </button>
                        <button onclick="exportData()" class="bg-slate-800 hover:bg-slate-700 text-blue-400 text-xs px-3 py-2 rounded-lg border border-slate-700">
                            <i class="fa-solid fa-download me-1"></i> JSON保存
                        </button>
                        <label class="bg-slate-800 hover:bg-slate-700 text-emerald-400 text-xs px-3 py-2 rounded-lg border border-slate-700 cursor-pointer">
                            <i class="fa-solid fa-upload me-1"></i> 復元
                            <input type="file" id="import-file" onchange="importData(event)" class="hidden" accept=".json">
                        </label>
                    </div>
                </div>

                <!-- 緊急テロップ配信制御 -->
                <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 shadow-lg space-y-2">
                    <h3 class="text-sm font-bold text-red-400 flex items-center gap-2">
                        <i class="fa-solid fa-bullhorn"></i> 全体本部アナウンス・緊急テロップ配信
                    </h3>
                    <div class="flex gap-2">
                        <input type="text" id="announcement-input" placeholder="例: 【本部より】上グラウンドサッカー試合順が10分全体遅延しています。" class="flex-1 bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white">
                        <button onclick="updateAnnouncement()" class="bg-red-600 hover:bg-red-500 text-white text-xs font-bold px-4 py-2 rounded-lg transition">配信・更新</button>
                        <button onclick="clearAnnouncement()" class="bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs px-3 py-2 rounded-lg border border-slate-700">消去</button>
                    </div>
                </div>

                <!-- 各コート進行一覧モニタ -->
                <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 shadow-lg space-y-3">
                    <h3 class="text-sm font-bold text-slate-200">全コートリアルタイム遅延・進行モニタ</h3>
                    <div id="admin-court-summary" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                        <!-- JSで動的生成 -->
                    </div>
                </div>
            </div>
        </section>

    </main>

    <!-- モーダル: 試合詳細・担当者・遅延調整 -->
    <div id="edit-modal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-slate-900 border border-slate-700 rounded-xl max-w-lg w-full p-5 space-y-4 shadow-2xl relative">
            <button onclick="closeModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white text-lg"><i class="fa-solid fa-xmark"></i></button>
            
            <div class="border-b border-slate-800 pb-3">
                <span id="modal-court-badge" class="bg-blue-600 text-white text-xs font-bold px-2 py-0.5 rounded">コート</span>
                <h3 id="modal-match-title" class="text-lg font-bold text-white mt-1">試合タイトル</h3>
                <p id="modal-match-time" class="text-xs text-slate-400 font-mono mt-0.5">予定時間</p>
            </div>

            <!-- 遅延1分単位調整 -->
            <div class="bg-slate-950 p-3 rounded-lg border border-slate-800 space-y-2">
                <label class="text-xs font-bold text-slate-300 block">遅延時間調整 (1分単位)</label>
                <div class="flex items-center gap-2">
                    <button onclick="adjustModalDelay(-5)" class="bg-slate-800 hover:bg-slate-700 text-red-400 font-bold px-3 py-1.5 rounded border border-slate-700 text-xs">-5分</button>
                    <button onclick="adjustModalDelay(-1)" class="bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold px-3 py-1.5 rounded border border-slate-700 text-xs">-1分</button>
                    <div class="flex-1 text-center font-mono font-bold text-lg text-amber-400" id="modal-delay-display">+0分</div>
                    <button onclick="adjustModalDelay(1)" class="bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold px-3 py-1.5 rounded border border-slate-700 text-xs">+1分</button>
                    <button onclick="adjustModalDelay(5)" class="bg-slate-800 hover:bg-slate-700 text-red-400 font-bold px-3 py-1.5 rounded border border-slate-700 text-xs">+5分</button>
                </div>
                <div class="flex items-center gap-2 pt-1">
                    <input type="checkbox" id="modal-cascade-delay" class="rounded bg-slate-900 border-slate-700 text-blue-600 focus:ring-0">
                    <label for="modal-cascade-delay" class="text-xs text-slate-400">このコートの以降の試合も連動してシフト調整する</label>
                </div>
            </div>

            <!-- 担当者入力 (審判・競技・出席) -->
            <div class="space-y-2">
                <label class="text-xs font-bold text-slate-300 block">担当パート員入力</label>
                <div class="grid grid-cols-3 gap-2">
                    <div>
                        <span class="text-[10px] text-slate-400 block mb-0.5">審判担当</span>
                        <input type="text" id="modal-referee" placeholder="氏名" class="w-full bg-slate-950 border border-slate-800 rounded px-2 py-1.5 text-xs text-white">
                    </div>
                    <div>
                        <span class="text-[10px] text-slate-400 block mb-0.5">競技担当</span>
                        <input type="text" id="modal-event" placeholder="氏名" class="w-full bg-slate-950 border border-slate-800 rounded px-2 py-1.5 text-xs text-white">
                    </div>
                    <div>
                        <span class="text-[10px] text-slate-400 block mb-0.5">出席担当</span>
                        <input type="text" id="modal-attendance" placeholder="氏名" class="w-full bg-slate-950 border border-slate-800 rounded px-2 py-1.5 text-xs text-white">
                    </div>
                </div>
            </div>

            <!-- ステータス変更 -->
            <div>
                <label class="text-xs font-bold text-slate-300 block mb-1">進行ステータス</label>
                <select id="modal-status" class="w-full bg-slate-950 border border-slate-800 rounded px-2 py-1.5 text-xs text-white">
                    <option value="PLANNED">未開始 (予定通り)</option>
                    <option value="IN_PROGRESS">進行中 (試合中)</option>
                    <option value="FINISHED">終了</option>
                </select>
            </div>

            <div class="flex gap-2 pt-2">
                <button onclick="saveModalChanges()" class="flex-1 bg-blue-600 hover:bg-blue-500 text-white font-bold py-2 rounded-lg text-xs transition">保存・更新</button>
                <button onclick="closeModal()" class="bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold px-4 py-2 rounded-lg text-xs border border-slate-700">キャンセル</button>
            </div>
        </div>
    </div>

    <!-- JSアプリケーションロジック -->
    <script>
        // PDFデータに基づく初期タイムテーブル
        const initialMatches = [
            // 上グラ
            { id: 101, court: '上グラ', grade: '中3', sport: 'サッカー', startTime: '08:50', duration: 67, delayMinutes: 0, status: 'PLANNED', referee: '', eventStaff: '', attendanceStaff: '' },
            { id: 102, court: '上グラ', grade: '高1', sport: 'サッカー', startTime: '10:10', duration: 67, delayMinutes: 0, status: 'PLANNED', referee: '', eventStaff: '', attendanceStaff: '' },
