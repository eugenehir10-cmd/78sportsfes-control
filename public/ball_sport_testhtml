                                <option value="A" ${cur[3] === 'A' ? 'selected' : ''}>A組</option>
                                <option value="B" ${cur[3] === 'B' ? 'selected' : ''}>B組</option>
                                <option value="C" ${cur[3] === 'C' ? 'selected' : ''}>C組</option>
                                <option value="D" ${cur[3] === 'D' ? 'selected' : ''}>D組</option>
                            </select>
                            <span class="text-slate-500 font-bold ms-1">4位:</span>
                            <select onchange="updateSportRank('${cat}', 4, this.value)" class="bg-slate-900 border border-slate-700 rounded px-1.5 py-1 text-xs text-white">
                                <option value="">-</option>
                                <option value="A" ${cur[4] === 'A' ? 'selected' : ''}>A組</option>
                                <option value="B" ${cur[4] === 'B' ? 'selected' : ''}>B組</option>
                                <option value="C" ${cur[4] === 'C' ? 'selected' : ''}>C組</option>
                                <option value="D" ${cur[4] === 'D' ? 'selected' : ''}>D組</option>
                            </select>
                        </div>
                    </div>
                `;
                container.insertAdjacentHTML('beforeend', html);
            });
        }

        function updateSportRank(category, rank, team) {
            if (!scores[category]) scores[category] = { 1: '', 2: '', 3: '', 4: '' };
            scores[category][rank] = team;
            saveData();
            updateScoresAndChart();
        }

        function updateScoresAndChart() {
            const pointsMap = { 1: 100, 2: 75, 3: 50, 4: 25 };
            const teamTotals = { A: 0, B: 0, C: 0, D: 0 };

            Object.keys(scores).forEach(cat => {
                const rankObj = scores[cat];
                for (let rank = 1; rank <= 4; rank++) {
                    const team = rankObj[rank];
                    if (team && teamTotals[team] !== undefined) {
                        teamTotals[team] += pointsMap[rank];
                    }
                }
            });

            ['A', 'B', 'C', 'D'].forEach(t => {
                document.getElementById(`score-${t}`).innerText = teamTotals[t];
            });

            // 順位算出
            const sorted = Object.entries(teamTotals).sort((a, b) => b[1] - a[1]);
            sorted.forEach((item, index) => {
                document.getElementById(`rank-${item[0]}`).innerText = `順位: ${index + 1}位`;
            });

            // Chart.js 描画
            const ctx = document.getElementById('scoreChart');
            if (ctx) {
                if (chartInstance) chartInstance.destroy();
                chartInstance = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: ['A組', 'B組', 'C組', 'D組'],
                        datasets: [{
                            label: '総合得点 (pt)',
                            data: [teamTotals.A, teamTotals.B, teamTotals.C, teamTotals.D],
                            backgroundColor: ['#ef4444', '#3b82f6', '#f59e0b', '#10b981'],
                            borderRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: { ticks: { color: '#94a3b8' }, grid: { color: '#1e293b' } },
                            x: { ticks: { color: '#f8fafc' }, grid: { display: false } }
                        }
                    }
                });
            }
        }

        // 本部認証
        function unlockAdmin() {
            const pwd = document.getElementById('admin-password').value;
            if (pwd === 'admin123') {
                isAdminUnlocked = true;
                document.getElementById('admin-lock-screen').classList.add('hidden');
                document.getElementById('admin-content').classList.remove('hidden');
                renderAdminSummary();
            } else {
                alert('パスワードが違います (初期: admin123)');
            }
        }

        function lockAdmin() {
            isAdminUnlocked = false;
            document.getElementById('admin-lock-screen').classList.remove('hidden');
            document.getElementById('admin-content').classList.add('hidden');
            document.getElementById('admin-password').value = '';
        }

        // 緊急アナウンス
        function updateAnnouncement() {
            const txt = document.getElementById('announcement-input').value;
            const container = document.getElementById('ticker-container');
            const target = document.getElementById('ticker-text');
            if (txt) {
                target.innerText = txt;
                container.classList.remove('hidden');
            } else {
                container.classList.add('hidden');
            }
        }

        function clearAnnouncement() {
            document.getElementById('announcement-input').value = '';
            document.getElementById('ticker-container').classList.add('hidden');
        }

        // 本部用全コートモニタ
        function renderAdminSummary() {
            const container = document.getElementById('admin-court-summary');
            if (!container) return;
            container.innerHTML = '';

            const courts = ['上グラ', '下グラ', '体育館', 'ハード', 'オムニ', '卓球場'];
            courts.forEach(c => {
                const cMatches = matches.filter(m => m.court === c);
                const maxDelay = Math.max(0, ...cMatches.map(m => m.delayMinutes));
                const inProgress = cMatches.find(m => m.status === 'IN_PROGRESS');

                const html = `
                    <div class="bg-slate-950 p-3 rounded-lg border ${maxDelay > 0 ? 'border-red-500/80 bg-red-950/20' : 'border-slate-800'} space-y-1">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-bold text-white">${c}</span>
                            ${maxDelay > 0 ? `<span class="text-[10px] bg-red-600 text-white font-bold px-1.5 py-0.5 rounded animate-pulse">遅延: +${maxDelay}分</span>` : `<span class="text-[10px] bg-emerald-600/30 text-emerald-400 border border-emerald-500/30 px-1.5 py-0.5 rounded">順調</span>`}
                        </div>
                        <div class="text-xs text-slate-300">
                            現在進行: <span class="font-bold text-blue-400">${inProgress ? `${inProgress.grade}${inProgress.sport}` : 'なし/定刻待ち'}</span>
                        </div>
                    </div>
                `;
                container.insertAdjacentHTML('beforeend', html);
            });
        }

        // JSONデータ入出力
        function exportData() {
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify({ matches, scores }));
            const downloadAnchor = document.createElement('a');
            downloadAnchor.setAttribute("href", dataStr);
            downloadAnchor.setAttribute("download", `78th_sportsfes_backup_${new Date().toISOString().slice(0,10)}.json`);
            document.body.appendChild(downloadAnchor);
            downloadAnchor.click();
            downloadAnchor.remove();
        }

        function importData(event) {
            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const parsed = JSON.parse(e.target.result);
                    if (parsed.matches && parsed.scores) {
                        matches = parsed.matches;
                        scores = parsed.scores;
                        saveData();
                        location.reload();
                    }
                } catch(err) {
                    alert('無効なファイル形式です');
                }
            };
            reader.readAsText(event.target.files[0]);
        }
    </script>
</body>
</html>
