rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function studentDirectoryOperator() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'jh62220120@s.musashi.ed.jp',
          'jh62220340@s.musashi.ed.jp',
          'jh62220140@s.musashi.ed.jp',
          'jh62231310@s.musashi.ed.jp',
          'jh62230450@s.musashi.ed.jp',
          'jh62220250@s.musashi.ed.jp',
          'jh62230440@s.musashi.ed.jp',
          'jh62220030@s.musashi.ed.jp',
          'jh62231560@s.musashi.ed.jp',
          'jh62230600@s.musashi.ed.jp',
          'jh62220260@s.musashi.ed.jp'
        ];
    }

    // Student records contain personal information. Only the directory
    // operator can read or replace the shared directory document.
    match /student_directory/current {
      allow read: if studentDirectoryOperator();
      allow create, update: if studentDirectoryOperator()
        && request.resource.data.keys().hasOnly(['rows', 'fields', 'attendanceSessions', 'updatedAt', 'updatedBy'])
        && request.resource.data.rows is list
        && request.resource.data.fields is list
        && request.resource.data.attendanceSessions is list
        && request.resource.data.updatedBy == request.auth.token.email;
      allow delete: if false;
    }

    // Everything outside the student directory is publicly accessible,
    // including app data, backups, equipment, and history collections.
    // Excluding the entire collection prevents this wildcard from exposing
    // student_directory/current through Firestore's additive rule matching.
    match /{collection}/{document=**} {
      allow read, write: if collection != 'student_directory';
    }
  }
}
